{
   "Version": "2012-10-17",
   "Statement": [
     {
       "Sid": "ReadUploadedDocumentMetadata",
       "Effect": "Allow",
       "Action": "s3:GetObject",
       "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME/incoming/*"
      },
      {
        "Sid": "PublishUploadNotification",
        "Effect": "Allow",
        "Action": "sns:Publish",
        "Resource": "YOUR-SNS-TOPIC-ARN"
      }
    ]
}
